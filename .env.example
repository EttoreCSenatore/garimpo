# Tivolli Scraper Environment Configuration
# Copy this file to .env and adjust values as needed.

# --- Application
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# --- Scraper
USER_AGENT=TivolliBot/1.0 (+https://yourdomain.example; contact@example.com)
BASE_URL=https://www.tivolli.com.br
REQUESTS_PER_SECOND=1
JITTER_MIN_MS=500
JITTER_MAX_MS=1500
MAX_RETRIES=3

# --- Database
DATABASE_URL=sqlite:///./tivolli.db

# --- Admin
ADMIN_TOKEN=change-me-to-a-secure-token

# --- Splunk HEC
SPLUNK_HEC_URL=https://localhost:8088/services/collector/event
SPLUNK_HEC_TOKEN=
SPLUNK_HEC_VERIFY_SSL=false
SPLUNK_HEC_BATCH_SIZE=50
SPLUNK_BUFFER_FILE=events.jsonl
SPLUNK_BUFFER_MAX_LINES=10000

# --- Scheduler
FULL_REFRESH_INTERVAL_MINUTES=360
INCREMENTAL_REFRESH_INTERVAL_MINUTES=15
INCREMENTAL_TOP_N=200

# --- Disclaimer
# If set to true, prices are returned as "indicative" and links back to source product page
DISCLAIMER=false

# --- Cache
CACHE_TTL_SECONDS=60
HOT_PRODUCT_CACHE_SIZE=500
