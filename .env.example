# Garimpo environment configuration
# Copy this file to .env and adjust values as needed.

# --- Application
APP_ENV=development
DEBUG=false
# Loopback by default. Containers set HOST=0.0.0.0 (see docker-compose.yml).
HOST=127.0.0.1
PORT=8000

# --- Scraper
# Identify your bot and give the site owner a way to contact you.
USER_AGENT=GarimpoBot/1.0 (+https://github.com/EttoreCSenatore/garimpo)
BASE_URL=https://www.tivolli.com.br
REQUESTS_PER_SECOND=1
JITTER_MIN_MS=500
JITTER_MAX_MS=1500
MAX_RETRIES=3

# --- Database
DATABASE_URL=sqlite:///./garimpo.db

# --- Admin
# Leave empty to disable the /admin endpoints. Required (>= 24 chars) when APP_ENV=production.
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=

# --- Browser access / abuse protection
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
IMAGE_PROXY_ALLOWED_HOSTS=www.tivolli.com.br
CHAT_RATE_LIMIT_PER_MINUTE=30
IMAGE_RATE_LIMIT_PER_MINUTE=240
# Only set to true behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false
# Number of trusted reverse proxies in front of the app (only used when TRUST_PROXY_HEADERS=true)
TRUSTED_PROXY_HOPS=1

# --- Scheduler
SCHEDULER_ENABLED=true
FULL_REFRESH_INTERVAL_MINUTES=360
INCREMENTAL_REFRESH_INTERVAL_MINUTES=15
INCREMENTAL_TOP_N=200

# --- Backups (SQLite only): daily online copy + weekly restore test, kept next to the database
BACKUP_ENABLED=true
BACKUP_DIR=
BACKUP_HOUR_UTC=6
BACKUP_KEEP=14
RESTORE_TEST_WEEKDAY=sun

# --- Heartbeats (Healthchecks.io style; empty disables). One check per job; silence means it stopped.
HEARTBEAT_FULL_URL=
HEARTBEAT_INCREMENTAL_URL=
HEARTBEAT_BACKUP_URL=
HEARTBEAT_RESTORE_URL=

# --- Freshness warnings (API field "stale" and a banner in the chat)
STALE_AFTER_HOURS=24
BACKUP_STALE_HOURS=26

# --- Prometheus metrics at /metrics (off by default; set a token and keep it behind your proxy)
METRICS_ENABLED=false
METRICS_TOKEN=

# --- Disclaimer
# If set to true, prices are returned as "indicative" and links back to source product page
DISCLAIMER=false

# --- Cache
CACHE_TTL_SECONDS=60
